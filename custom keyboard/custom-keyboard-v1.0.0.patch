+    ConfigurationGroup {
+        id: keyboardConfig
+        path: "/apps/custom-keyboard"
+
+        property string layoutJson: "{}"
+    }
+
+    property string configJson: keyboardConfig.layoutJson
+
+    property var layoutData: {
+        try {
+            return JSON.parse(configJson)
+        } catch (e) {
+            console.log("CUSTOM JSON parse error:", e)
+            return ({})
+        }
+    }
+
+    property var row3Keys: [
+        "z", "x", "c", "v", "b", "n", "m",
+        "row3extra1", "row3extra2"
+    ]
+
+    function keyValue(key, field, fallback) {
+        if (layoutData
+                && layoutData[key]
+                && layoutData[key][field] !== undefined) {
+            return layoutData[key][field]
+        }
+
+        return fallback
+    }
+
+    function keyActive(key, fallback) {
+        if (layoutData
+                && layoutData[key]
+                && layoutData[key]["active"] !== undefined) {
+            return layoutData[key]["active"]
+        }
+
+        return fallback
+    }
+
+    function defaultActive(key) {
+        return key !== "row1extra1"
+                && key !== "row1extra2"
+                && key !== "row2extra1"
+                && key !== "row2extra2"
+                && key !== "row3extra1"
+                && key !== "row3extra2"
+                && key !== "punctExtra"
+    }
+
+    function activeCount(keys) {
+        var count = 0
+
+        for (var i = 0; i < keys.length; ++i) {
+            if (keyActive(keys[i], defaultActive(keys[i])))
+                ++count
+        }
+
+        return count
+    }
+
+    readonly property int row3ActiveCount:
+        activeCount(row3Keys)
+
+    readonly property int row3SplitIndex:
+        Math.max(1, Math.floor((row3ActiveCount + 3) / 2))
+
